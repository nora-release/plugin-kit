{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nora plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "summary",
    "publisher",
    "extensionBundleIdentifier"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1
    },
    "apiVersion": {
      "const": 1,
      "default": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "iconPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Optional brand icon relative to the native application\u2019s Contents/Resources directory, packaged as a regular SVG, PNG, or JPEG resource of at most 512 KiB. Symbolic links are prohibited.",
      "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?:[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+/)*[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]*\\.(?:svg|png|jpg|jpeg)$",
      "not": {
        "anyOf": [
          {
            "pattern": "[\\\\\\u0000-\\u001f\\u007f-\\u009f]"
          },
          {
            "pattern": "^[Cc][Oo][Nn][Tt][Ee][Nn][Tt][Ss]/[Rr][Ee][Ss][Oo][Uu][Rr][Cc][Ee][Ss]/"
          }
        ]
      }
    },
    "networkDomains": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/networkHost"
      },
      "default": []
    },
    "extensionBundleIdentifier": {
      "$ref": "#/$defs/identifier"
    },
    "permissions": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "hostInfo",
          "notifications",
          "network",
          "credentials",
          "openExternal",
          "chat"
        ]
      },
      "default": []
    },
    "panels": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/panel"
      },
      "default": []
    },
    "commands": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/command"
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "networkDomains"
        ],
        "properties": {
          "networkDomains": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "permissions"
        ],
        "properties": {
          "permissions": {
            "contains": {
              "const": "network"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "networkHost": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$",
      "not": {
        "pattern": "[^a-z0-9.-]"
      }
    },
    "identifier": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "systemImage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Must begin with the manifest id followed by a dot, and be unique across panels and commands."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "systemImage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "inputSchemaJSON",
        "readOnly"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Must begin with the manifest id followed by a dot, and be unique across panels and commands."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inputSchemaJSON": {
          "type": "string",
          "maxLength": 65536,
          "description": "A JSON schema with type object; at most 64 KiB UTF-8."
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    }
  }
}
